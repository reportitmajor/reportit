<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardReportItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:rippleColor="#1A006494"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: ID + Ward Chip + Status Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReportId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="RI-2026-004821"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="•"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReportWard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ward 150 - Bellandur"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="#DBEAFE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="In Progress"
                android:textColor="#2563EB"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main Content Row: Thumbnail + Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Thumbnail with Severity Overlay -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivReportThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_pothole_evidence"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                <!-- Severity Badge Overlay -->
                <TextView
                    android:id="@+id/tvSeverityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_status_badge"
                    android:backgroundTint="#DC2626"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="High"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Details Block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReportTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Deep Road Pothole and Asphalt Depression"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_location"
                        app:tint="#64748B" />

                    <TextView
                        android:id="@+id/tvReportLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Outer Ring Road, Bellandur, Bengaluru"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvReportDepartment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_status_badge"
                    android:backgroundTint="#FFF7ED"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="BBMP Road Infrastructure Division"
                    android:textColor="#EA580C"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#F1F5F9" />

        <!-- Footer Row: SLA Remaining / Status + Upvote & Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivSlaClock"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_schedule"
                app:tint="#2563EB" />

            <TextView
                android:id="@+id/tvSlaCountdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="SLA: 18h remaining"
                android:textColor="#2563EB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Upvote Button with Count -->
            <LinearLayout
                android:id="@+id/layoutUpvote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp">

                <ImageView
                    android:id="@+id/ivUpvote"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_thumb_up"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvUpvoteCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="34"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSubmissionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="02 May 2026"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
